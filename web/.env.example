# Copy to .env.local and fill in to sign in with Entra ID locally.
# Leave VITE_AUTH_MODE unset (or "dev") to run as the fake dev user instead.
VITE_AUTH_MODE=entra
VITE_ENTRA_TENANT_ID=<cta-tenant-id>
VITE_ENTRA_CLIENT_ID=<spa-app-registration-client-id>
VITE_API_SCOPE=api://<api-app-registration-client-id>/access_as_user
# Optional: where the header's app launcher goes.
VITE_APP_LAUNCHER_URL=
